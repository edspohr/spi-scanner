rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Función helper ────────────────────────────────────────────────────────
    // Verifica que el usuario esté autenticado con correo verificado de un dominio autorizado
    function isSpiMember() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower().matches('^[^@]+@(spiamericas\\.com|spohr\\.cl)$')
        && request.auth.token.email_verified == true;
    }

    // ─── Oportunidades regulatorias ────────────────────────────────────────────
    match /regulatory_opportunities/{opportunityId} {
      allow read: if isSpiMember();
      allow write: if isSpiMember();
    }

    // ─── Fuentes oficiales (catálogo de agencias) ──────────────────────────────
    match /official_sources/{sourceId} {
      allow read: if isSpiMember();
      allow write: if false; // Validación y cambios mediante manageOfficialSource
    }

    // ─── Miembros del equipo SPI ───────────────────────────────────────────────
    match /team_members/{memberId} {
      allow read: if isSpiMember();
      allow write: if isSpiMember();
    }

    // ─── Digest ejecutivo diario ───────────────────────────────────────────────
    match /daily_digests/{digestId} {
      allow read: if isSpiMember();
      // Solo Cloud Functions (admin SDK) pueden escribir; el cliente solo lee
      allow write: if false;
    }
    match /scan_runs/{runId} {
      allow read: if isSpiMember();
      allow write: if false;
    }
    // ─── Registro de deduplicación (solo Cloud Functions Admin SDK escribe) ────
    match /processed_documents/{docHash} {
      allow read: if isSpiMember();
      allow write: if false; // Solo Cloud Functions Admin SDK
    }
  }
}
