rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite lectura y escritura a miembros autenticados del equipo SPI
    match /regulatory_opportunities/{opportunityId} {
      allow read: if true;
      allow write: if true; // En producción: if request.auth != null;
    }
    match /official_sources/{sourceId} {
      allow read: if true;
      allow write: if true;
    }
    match /team_members/{memberId} {
      allow read: if true;
      allow write: if true;
    }
    match /daily_digests/{digestId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
